diff --git a/src/discount.js b/src/discount.js
new file mode 100644
index 0000000..a0e856b
--- /dev/null
+++ b/src/discount.js
@@ -0,0 +1,6 @@
+const CODES = { SAVE10: 0.1 };
+
+export function applyDiscount(total, code) {
+  const rate = CODES[code] ?? 0;
+  return Math.round(total * (1 - rate) * 100) / 100;
+}
diff --git a/tests/discount.test.js b/tests/discount.test.js
new file mode 100644
index 0000000..f9f17e9
--- /dev/null
+++ b/tests/discount.test.js
@@ -0,0 +1,11 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { applyDiscount } from '../src/discount.js';
+
+test('R-01 SAVE10 takes 10% off, rounded to cents', () => {
+  assert.equal(applyDiscount(19.99, 'SAVE10'), 17.99);
+});
+
+test('R-02 unknown code leaves the total', () => {
+  assert.equal(applyDiscount(10, 'NOPE'), 10);
+});
