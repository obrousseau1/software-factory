@@ -0,0 +1,20 @@
+import { useState } from 'react';
+import { applyDiscount } from './discount.js';
+
+export function DiscountForm({ total }) {
+  const [code, setCode] = useState('');
+  const [result, setResult] = useState(total);
+  const [error, setError] = useState(null);
+  const submit = (e) => {
+    e.preventDefault();
+    try { setResult(applyDiscount(total, code)); setError(null); } catch { /* ignore */ }
+  };
+  return (
+    <form onSubmit={submit}>
+      <input placeholder="code" value={code} onChange={(e) => setCode(e.target.value)} />
+      <button type="submit">Apply</button>
+      {error && <p role="alert">{error}</p>}
+      <p>Total: {result}</p>
+    </form>
+  );
+}
diff --git a/src/discount.js b/src/discount.js
new file mode 100644
index 0000000..84cb4d8
--- /dev/null
+++ b/src/discount.js
@@ -0,0 +1,6 @@
+const CODES = { SAVE10: 0.1 };
+
+export function applyDiscount(total, code) {
+  if (!(code in CODES)) throw new Error(`Unknown code: ${code}`);
+  return Math.round(total * (1 - CODES[code]) * 100) / 100;
+}
